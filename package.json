  "version": "0.0.0",
  "scripts": {
    "dev": "vite --host",
    "getEntries": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx script/getEntries.mts",
    "getResults": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx script/getResults.mts",
    "getAvatars": "NODE_TLS_REJECT_UNAUTHORIZED=0 tsx script/getAvatars.mts",
